# Copia este archivo a .env.local (git lo ignora) y completa con valores de DESARROLLO.
# Local: `supabase status -o env` imprime la URL y la clave pública.
# Estas dos variables son públicas por diseño; la seguridad la da el RLS.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=

# La llave service_role NO va aquí ni en el front. Solo la usan las funciones del
# servidor (secretos de Supabase) o scripts locales de siembra, fuera del repositorio.

# Inicio de sesión con Google (solo para activar [auth.external.google] en supabase/config.toml).
# Los valores salen de Google Cloud Console; no los subas al repositorio.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
