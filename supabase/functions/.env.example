# Secretos de las Edge Functions de Bold (copia a supabase/functions/.env para `supabase functions serve --env-file`).
# En producción se cargan con `supabase secrets set`. Nunca van al repositorio ni al navegador.
BOLD_IDENTITY_KEY=
BOLD_SECRET_KEY=
SITE_URL=http://localhost:5173
# Contraseña que inventas tú (no viene de Bold): protege bold-conciliar. Quien la llame debe enviarla en x-conciliacion-token.
BOLD_RECONCILE_TOKEN=
# SOLO local/pruebas: el sandbox de Bold firma el webhook con llave vacía. Con 1 se acepta además esa firma.
# Nunca en producción: la función lo ignora si el proyecto es *.supabase.co, pero no lo cargues allí.
BOLD_ACEPTAR_FIRMA_VACIA_PRUEBAS=0
